# Supabase Configuration
# Get these values from your Supabase project dashboard at https://app.supabase.com
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
# Get these values from your Stripe dashboard at https://dashboard.stripe.com
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Brevo SMS Configuration (Platform-Level - Primary SMS Provider)
# Brevo is the primary SMS provider for the platform
# Get these values from your Brevo account at https://app.brevo.com
BREVO_API_KEY=your_brevo_api_key
BREVO_SMS_SENDER=your_brevo_sender_name_or_number

# Brevo API Requirements:
# - API Key is found in Brevo Dashboard > SMTP & API > API Keys
#   Direct link: https://app.brevo.com/settings/keys/api
# - The same API key is used for both email and SMS services
# - Sender can be either:
#   * A verified phone number (E.164 format: +1234567890)
#   * An alphanumeric sender ID (3-11 characters, letters only for most countries)
# - Alphanumeric sender IDs may require pre-registration depending on country
# - Check Brevo documentation for country-specific SMS regulations
# - Example senders: +12345678900 or YourBrand
# - IMPORTANT: Use the same branding as EMAIL_FROM_NAME for consistency (e.g., both "LoyaltyHub")
#
# IMPORTANT - Supabase Secrets Configuration:
# These credentials MUST be added to Supabase Edge Function secrets for production use.
# Steps to configure:
# 1. Log in to your Supabase dashboard
# 2. Navigate to: Project Settings → Edge Functions → Secrets
# 3. Add both secrets with the exact names: BREVO_API_KEY and BREVO_SMS_SENDER
# 4. Test the configuration using the Super Admin Test Communications page
#
# Local Development:
# - For local testing, add these to your .env file
# - For production Edge Functions, they MUST be in Supabase secrets
#
# Troubleshooting:
# - If SMS fails with "No provider configured", verify secrets are set in Supabase
# - Check Platform Configuration page for credential status indicators
# - Review Edge Function logs for specific configuration errors
# - Ensure sender ID is verified in your Brevo account

# Twilio SMS Configuration (Platform-Level - Fallback SMS Provider)
# Twilio is the fallback SMS provider when Brevo is unavailable
# Get these values from your Twilio Console at https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Twilio API Requirements:
# - Account SID and Auth Token are found in your Twilio Console Dashboard
#   Direct link: https://console.twilio.com/
# - Phone Number must be a Twilio number in E.164 format: +1234567890
# - Ensure the number has SMS capabilities enabled
# - Configure messaging service if you want advanced features
# - Check Twilio documentation for country-specific SMS regulations
#
# IMPORTANT - Supabase Secrets Configuration:
# Like Brevo, these credentials MUST be added to Supabase Edge Function secrets.
# Steps to configure:
# 1. Log in to your Supabase dashboard
# 2. Navigate to: Project Settings → Edge Functions → Secrets
# 3. Add all three secrets: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
# 4. Twilio serves as automatic fallback when Brevo fails
#
# Note: Having both Brevo and Twilio configured provides redundancy

# Vonage SMS Configuration (Platform-Level - Legacy/Alternative)
# These are platform-level credentials used as fallback when businesses haven't configured their own Vonage integration
# Get these values from your Vonage API Dashboard at https://dashboard.nexmo.com
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM_NUMBER=your_vonage_phone_number_or_sender_id

# Vonage API Requirements:
# - API Key and API Secret are found in your Vonage Dashboard
# - From Number can be either:
#   * A Vonage virtual number (E.164 format: +1234567890)
#   * An alphanumeric sender ID (3-11 characters, letters and numbers only)
# - Alphanumeric sender IDs may require pre-registration depending on country
# - Check Vonage documentation for country-specific SMS regulations
# - Example numbers: +12345678900 or YourBrand
#
# Note: For Supabase Edge Functions to access these Vonage variables, you must also add them
# to your Supabase project secrets via Dashboard > Project Settings > Edge Functions > Secrets

# Brevo Email Configuration (Platform-Level)
# Brevo is the primary email provider for the platform (uses same API key as SMS)
# Get these values from your Brevo account at https://app.brevo.com
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=LoyaltyHub

# Brevo Email Requirements:
# - Uses BREVO_API_KEY configured above (same key for email and SMS)
# - FROM email must be verified in your Brevo account
#   Verify at: https://app.brevo.com/settings/sender
# - From Name is the display name shown to recipients
# - Brevo supports transactional and marketing emails
# - Keep API key secure and never commit it to version control
#
# IMPORTANT - Supabase Secrets Configuration:
# These email settings also need to be in Supabase Edge Function secrets:
# 1. EMAIL_FROM - The verified sender email address
# 2. EMAIL_FROM_NAME - Display name for emails
# Note: BREVO_API_KEY is already configured for SMS and works for email too

# SendGrid Configuration (Platform-Level - Legacy/Alternative)
# These are platform-level credentials used as fallback when businesses haven't configured their own SendGrid integration
# Get these values from your SendGrid dashboard at https://app.sendgrid.com
SENDGRID_API_KEY=your_sendgrid_api_key

# SendGrid API Key Requirements:
# - Create API key with "Mail Send" permission at minimum
# - For webhook support, also enable "Tracking" permission
# - Keep this key secure and never commit it to version control
# - Verify sender email/domain in SendGrid before sending emails
#
# Note: For Supabase Edge Functions to access these SendGrid variables, you must also add them
# to your Supabase project secrets via Dashboard > Project Settings > Edge Functions > Secrets
